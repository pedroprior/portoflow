# Copie para .env e troque os valores. O arquivo .env nunca vai para o Git.

# Banco (usado pelo serviço db e para montar DATABASE_URL da API)
POSTGRES_DB=portoflow
POSTGRES_USER=portoflow
POSTGRES_PASSWORD=troque-esta-senha

# JWT: gere com  python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=troque-por-um-segredo-longo-e-aleatorio
JWT_EXPIRA_MIN=60

# Origem do front-end liberada no CORS
CORS_ORIGEM=http://localhost:5173

# Senhas dos usuários criados pelo seed
SEED_SENHA_ADMIN=troque-a-senha-do-admin
SEED_SENHA_PADRAO=troque-a-senha-dos-demais

# Fora do Docker (rodando a API localmente), informe a URL completa:
# DATABASE_URL=postgresql+psycopg://portoflow:troque-esta-senha@localhost:5432/portoflow
